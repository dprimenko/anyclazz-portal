---
import Base from '@/layout/Base.astro';
import OnboardingLayout from '@/features/teachers/onboarding/OnboardingLayout';
import OnboardingStep5 from '@/features/teachers/onboarding/OnboardingStep5';
import { getLangFromAstro } from '@/i18n';
import { getSession } from 'auth-astro/server';
import { AnyclazzAuthRepository } from '@/features/auth/ssr/infrastructure/AnyclazzAuthRepository';
import { ApiTeacherRepository } from '@/features/teachers/infrastructure/ApiTeacherRepository';
import type { AuthUser } from '@/features/auth/domain/types';

export const prerender = false;

const session = await getSession(Astro.request);
const token = session?.accessToken as string;

if (!token) {
  return Astro.redirect('/login');
}

const lang = getLangFromAstro(Astro.cookies);

const authRepository = new AnyclazzAuthRepository();
const profileData = await authRepository.getUserProfile(token);

if (!profileData || !profileData.teacherProfile) {
  return Astro.redirect('/login');
}

const teacherId = profileData.teacherProfile.id;

const teacherRepository = new ApiTeacherRepository();
let teacher = null;
let stripeConnectStatus = null;

// Ejecutar en paralelo para reducir tiempo de carga
[teacher, stripeConnectStatus] = await Promise.all([
  teacherRepository.getTeacher({ token, teacherId }).catch((error) => {
    console.error('Error loading teacher data:', error);
    return null;
  }),
  teacherRepository.getStripeConnectStatus({ token }).catch((error) => {
    console.error('Error loading Stripe Connect status:', error);
    return null;
  }),
]);

// Extraer parámetros OAuth de la URL (callback de Stripe)
const oauthCode = Astro.url.searchParams.get('code');
const oauthState = Astro.url.searchParams.get('state');
const oauthError = Astro.url.searchParams.get('error');
const oauthErrorDescription = Astro.url.searchParams.get('error_description');

const country = teacher?.teacherAddress?.country || 'US';

const user: AuthUser = {
  id: profileData.user.id,
  email: profileData.user.email,
  name: `${profileData.user.firstName} ${profileData.user.lastName}`,
  firstName: profileData.user.firstName,
  lastName: profileData.user.lastName,
  timezone: profileData.user.timezone || 'America/New_York',
  role: 'teacher',
  language: profileData.user.language,
  avatarUrl: profileData.teacherProfile?.avatar,
};
---

<Base noindex={true}>
    <OnboardingLayout currentStep={5} user={user} accessToken={token} lang={lang} client:load>
        <OnboardingStep5
            lang={lang}
            token={token}
            country={country}
            initialStatus={stripeConnectStatus}
            oauthCode={oauthCode}
            oauthState={oauthState}
            oauthError={oauthErrorDescription || oauthError}
            client:load
        />
    </OnboardingLayout>
</Base>

<script>
    // Limpiar parámetros OAuth de la URL sin recargar la página
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('code') || urlParams.has('error')) {
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, '', cleanUrl);
    }
</script>
